{
  "name": "elmaonline-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@elmadev/react-rec-viewer": "^0.1.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fingerprintjs/fingerprintjs": "^4.5.1",
    "@kevinwolf/formal-web": "^0.1.3",
    "@material-ui/core": "4.12.4",
    "@material-ui/icons": "4.11.3",
    "@material-ui/lab": "^4.0.0-alpha.57",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "apisauce": "^3.2.2",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "easy-peasy": "^6.1.1",
    "elma-js": "https://github.com/ville-j/elma-js",
    "flag-icons": "^7.5.0",
    "leaflet": "^1.9.4",
    "level-editor-gui": "https://github.com/elmadev/level-editor-gui.git",
    "lodash": "^4.18.1",
    "memoizee": "^0.4.17",
    "nanoid": "^5.1.16",
    "query-string": "9.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "14.3.5",
    "react-google-recaptcha": "^3.1.0",
    "react-helmet-async": "^2.0.5",
    "react-leaflet": "4.2.1",
    "react-outside-click-handler": "^1.3.0",
    "react-tiny-bbcode": "^0.4.0",
    "react-window": "1.8.11",
    "recharts": "2.15.4",
    "universal-cookie": "^7.2.2",
    "use-debounce": "^10.1.1",
    "yup": "^1.7.1"
  },
  "scripts": {
    "start": "vite --mode test",
    "start:dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "g": "plop",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prettier": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "commit": "git-cz",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --config e2e/playwright.config.js",
    "test:e2e:guest": "playwright test --config e2e/playwright.config.js --project=guest",
    "test:e2e:user": "playwright test --config e2e/playwright.config.js --project=user",
    "test:e2e:coverage": "node e2e/coverage.js",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.js --ui",
    "test:e2e:quick": "E2E_EXPLORE=0 playwright test --config e2e/playwright.config.js",
    "test:e2e:update": "playwright test --config e2e/playwright.config.js --update-snapshots"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/lodash": "^4.17.25",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.3",
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.2.1",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "husky": "^4.3.8",
    "lint-staged": "^15.2.10",
    "plop": "^4.0.5",
    "prettier": "^3.9.9",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "storybook": "^10.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.10"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.cjs"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint ."
  }
}
