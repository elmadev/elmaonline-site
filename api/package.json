{
  "name": "elmaonline-site",
  "type": "module",
  "private": true,
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "main": "src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "nodemon --no-warnings",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "importscheck": "node scripts/importscheck.js",
    "commit": "git-cz"
  },
  "dependencies": {
    "apisauce": "^3.1.0",
    "archiver": "^7.0.1",
    "aws-sdk": "^2.1692.0",
    "body-parser": "^1.20.3",
    "commitizen": "^4.3.1",
    "cors": "^2.8.5",
    "cz-customizable": "^7.2.1",
    "date-fns": "^4.1.0",
    "disco-oauth": "^5.1.1",
    "elma-js": "https://github.com/ville-j/elma-js",
    "elma-pcx": "^1.0.1",
    "elmajs": "^1.2.4",
    "express": "^4.21.1",
    "express-fileupload": "^1.5.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.2.0",
    "husky": "^8.0.1",
    "jimp": "^1.6.0",
    "jws": "^4.0.0",
    "lint-staged": "^15.2.10",
    "lodash-contrib": "^4.1200.1",
    "lodash-es": "^4.17.21",
    "mysql2": "^3.11.4",
    "nanoid": "^5.0.8",
    "neo-async": "^2.6.2",
    "read-chunk": "4.0.3",
    "request": "^2.88.2",
    "sanitize-html": "^2.17.0",
    "sequelize": "^6.37.5",
    "sharp": "^0.33.5",
    "sib-api-v3-sdk": "^8.5.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-fileupload": "^1.5.1",
    "@types/jws": "^3.2.11",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "@types/request": "^2.48.13",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.12.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "imports": {
    "#api/*": "./src/api/*",
    "#constants/*": "./src/constants/*",
    "#data/*": "./src/data/*",
    "#data/models": "./src/data/models/index.js",
    "#middlewares/*": "./src/middlewares/*",
    "#utils/*": "./src/utils/*",
    "#okevalidator/*": "./src/okevalidator/*"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": "eslint . --cache --fix"
  },
  "nodemonConfig": {
    "ext": "js,ts,json",
    "env": {
      "NODE_ENV": "development"
    }
  }
}
